{
  "name": "Olist Marketplace Analytics - Lakeflow Pipeline",
  "email_notifications": {
    "on_failure": [
      "willianapamorim@gmail.com"
    ]
  },
  "timeout_seconds": 900,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "run_bronze",
      "spark_python_task": {
        "python_file": "src/01_bronze/run_bronze.py"
      },
      "job_cluster_key": "serverless_cluster",
      "max_retries": 1
    },
    {
      "task_key": "run_silver",
      "depends_on": [
        {
          "task_key": "run_bronze"
        }
      ],
      "spark_python_task": {
        "python_file": "src/02_silver/run_silver.py"
      },
      "job_cluster_key": "serverless_cluster",
      "max_retries": 1
    },
    {
      "task_key": "run_gold",
      "depends_on": [
        {
          "task_key": "run_silver"
        }
      ],
      "spark_python_task": {
        "python_file": "src/03_gold/run_gold.py"
      },
      "job_cluster_key": "serverless_cluster",
      "max_retries": 1
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "serverless_cluster",
      "new_cluster": {
        "spark_version": "13.3.x-scala2.12",
        "node_type_id": "Serverless"
      }
    }
  ],
  "format": "MULTI_TASK"
}
